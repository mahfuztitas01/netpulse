# ============================================================
# NetPulse environment configuration
# Copy to `.env` and edit. NEVER commit `.env`.
# ============================================================

# --- Core ---
APP_NAME=NetPulse
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./netpulse.db
# PostgreSQL (free tier on Neon/Supabase):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/netpulse

# --- Monitoring engine ---
MONITOR_TICK_SECONDS=5
MAX_CONCURRENCY=200
PING_PRIVILEGED=true
DOWN_FAILURE_THRESHOLD=1
UP_SUCCESS_THRESHOLD=1
HISTORY_RETENTION_DAYS=30
METRICS_RETENTION_DAYS=14
ALERT_RENOTIFY_MINUTES=30
LATENCY_ALERT_COOLDOWN_MINUTES=10

# --- SNMP ---
SNMP_TIMEOUT=3
SNMP_RETRIES=1
SNMP_DEFAULT_PORT=161
SNMP_MAX_INTERFACES=64
METRICS_INTERVAL_SECONDS=60

# --- Default metric thresholds (per-device overrides in the UI) ---
CPU_THRESHOLD_PERCENT=85
RAM_THRESHOLD_PERCENT=90

# --- WireGuard ---
WG_ENABLED=false
WG_INTERFACE=wg0
WG_CONFIG_DIR=/etc/wireguard
WG_MANAGE=false

# --- Telegram notifications ---
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- First admin (created automatically on first run if no users exist) ---
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=change-me-strong-password
FIRST_ADMIN_EMAIL=admin@example.com

# --- Deployment ---
COOKIE_SECURE=false
# Optional: restrict dashboard access by source CIDR (comma separated)
DASHBOARD_ALLOW_CIDRS=
