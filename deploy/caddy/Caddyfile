# Caddy reverse proxy with automatic free HTTPS (Let's Encrypt).
#
# [MANUAL ACTION] Replace the address below with:
#     <YOUR_VM_PUBLIC_IP>.sslip.io
# sslip.io resolves any "<ip>.sslip.io" to that IP, so no domain purchase is
# needed. Example: 129.146.10.20.sslip.io
#
# Then:
#   sudo cp deploy/caddy/Caddyfile /etc/caddy/Caddyfile
#   sudo systemctl restart caddy
#   # set COOKIE_SECURE=true in /opt/netpulse/.env and restart netpulse

129.146.10.20.sslip.io {
    encode gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        -Server
    }

    reverse_proxy 127.0.0.1:8000
}
